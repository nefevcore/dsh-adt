{
  "name": "@nefevcore/abap-adt-protocol",
  "version": "0.2.0",
  "description": "Pure-TypeScript client for the SAP ABAP Development Tools (ADT) REST protocol: authentication, session, CSRF, object CRUD, activation, search, ABAP Unit, ATC and transport management.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "undici": "^7.0.0"
  },
  "license": "MIT",
  "keywords": [
    "abap",
    "sap",
    "sap-abap",
    "adt",
    "abap-adt",
    "abap-development-tools",
    "rest",
    "abap-unit",
    "atc",
    "transport"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nefevcore/dsh-adt.git",
    "directory": "packages/adt-protocol"
  },
  "bugs": {
    "url": "https://github.com/nefevcore/dsh-adt/issues"
  },
  "homepage": "https://github.com/nefevcore/dsh-adt#readme",
  "publishConfig": {
    "access": "public"
  }
}
