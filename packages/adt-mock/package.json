{
  "name": "@abap-adt/mock",
  "version": "0.1.0",
  "description": "In-memory mock of the SAP ADT REST service for local end-to-end testing of the ADT protocol client without a real ABAP system.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -b",
    "start": "node lib/cli.js"
  },
  "dependencies": {
    "@abap-adt/protocol": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
