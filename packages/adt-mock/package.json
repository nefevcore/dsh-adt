{
  "name": "@nefevcore/abap-adt-mock",
  "version": "0.3.1",
  "description": "In-memory mock of the SAP ADT REST service for local end-to-end testing of the ADT protocol client without a real ABAP system.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -b",
    "start": "node lib/cli.js"
  },
  "dependencies": {
    "@nefevcore/abap-adt-protocol": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "abap",
    "sap",
    "adt",
    "abap-adt",
    "mock",
    "mock-server",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nefevcore/dsh-adt.git",
    "directory": "packages/adt-mock"
  },
  "bugs": {
    "url": "https://github.com/nefevcore/dsh-adt/issues"
  },
  "homepage": "https://github.com/nefevcore/dsh-adt#readme",
  "publishConfig": {
    "access": "public"
  }
}

