{
  "name": "@nefevcore/abap-adt-core",
  "version": "0.7.2",
  "description": "Host-neutral agent tool core for SAP ABAP ADT: the complete adt_* tool family (search → read → edit → activate → unit test → ATC → transport → execute → debug), destination registry, two-sided governance policy, OCC snapshots and config layering — consumed by host adapters such as @nefevcore/abap-adt-dsh-plugin (DeepSeek Harness) and AgentChat's ac-sap-adt row.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p ."
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "^1.8.2",
    "@deepseek-ai/schemastery": "^3.0.0",
    "@nefevcore/abap-adt-mock": "workspace:*",
    "@nefevcore/abap-adt-protocol": "workspace:*",
    "@abaplint/core": "^2.120.23",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "abap",
    "sap",
    "sap-abap",
    "adt",
    "abap-adt",
    "abap-development-tools",
    "agent-tools",
    "ai-agent",
    "abap-unit",
    "atc",
    "abaplint",
    "host-neutral"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nefevcore/dsh-adt.git",
    "directory": "packages/adt-core"
  },
  "bugs": {
    "url": "https://github.com/nefevcore/dsh-adt/issues"
  },
  "homepage": "https://github.com/nefevcore/dsh-adt#readme",
  "publishConfig": {
    "access": "public"
  }
}
