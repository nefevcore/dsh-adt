# abap-adt 的 settings 用户段 —— 把本段合并进 ~/.dsh/settings.yaml 后按需修改。
# 保存即热生效（目的地表与权限策略原地重建，无需重启 DSH）。
#
# 解析优先级（就近覆盖）：本段（settings 用户层）> 插件行内联 config
# （预设/patch 的 composition base）> schema 默认值；权限四开关在本段与
# 内联均未设置时看 SAP_* 环境变量。destinations 跨层按名字合并，
# 本段的同名条目覆盖内联，新名字追加。
#
# ⚠ 密码不要明文写进任何配置：用 passwordEnv 指到环境变量
#   （缺省约定 ADT_<目的地名大写>_PASSWORD，或统一 ADT_PASSWORD）。
#   PowerShell:  setx ADT_DEV_PASSWORD '...'   （新开终端生效）

abap-adt:
  # 工具未显式传 destination 时使用的默认目的地名。
  defaultDestination: dev

  # --- 权限管控：全局默认（可选；不写则看 SAP_* 环境变量，再不写用默认）---
  # 六个开关也可以在每个 destination 里用 policy: 块按系统覆盖（见下）；
  # 生效值 = 全局默认 + 该目的地 policy 覆盖，逐键就近生效。
  # enableTransports: true              # false = 禁用传输工具族与一切传输写入
  # allowedTransports: 'D01K96*'        # 允许的传输号 glob，逗号分隔；'*' = 全部
  # allowTransportableEdits: true       # false = 只允许编辑 $TMP 本地对象
  # allowedPackages: 'Z*,$TMP'          # 允许编辑的开发包 glob；'$TMP' 需显式列出
  # allowExecution: true                # false = 禁用 adt_execute（运行任意 ABAP 可改系统状态）
  # allowBatchWrites: false             # true = 允许 adt_batch 的 POST/PUT 内嵌写（默认只读扇出）

  # --- 目的地列表 ---
  destinations:
    - name: dev
      url: https://sap.example.com:44300   # ABAP 前端 HTTP(S) 地址
      client: '100'                        # 集团（字符串）
      language: ZH
      username: DEVELOPER
      passwordEnv: ADT_DEV_PASSWORD        # 密码走环境变量（推荐）
      strictSSL: false                     # 自签名证书（SAP 内网常见）时必须 false
      # timeoutMs: 60000                   # 可选，默认 60s
      # 按系统收紧权限（可选，逐键覆盖全局默认）：
      # policy:
      #   allowedTransports: 'D01K96*'     # dev 只允许这一批传输号
      #   allowTransportableEdits: true

    # 第二个系统照抄一段即可（可以更保守——比如 QAS 只读 + 不碰传输）：
    # - name: qas
    #   url: https://sap-qas.example.com:44300
    #   client: '100'
    #   language: ZH
    #   username: DEVELOPER
    #   passwordEnv: ADT_QAS_PASSWORD
    #   strictSSL: false
    #   policy:
    #     enableTransports: false           # qas 上禁用整个传输工具族
    #     allowedPackages: '$TMP'           # qas 上只能编辑本地对象
    #     allowExecution: false             # qas 上禁止运行程序/类
    #     allowBatchWrites: false           # qas 上 $batch 保持只读
