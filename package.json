{
  "name": "dsh-abap-adt",
  "version": "0.1.0",
  "private": true,
  "description": "ABAP Development Tools (ADT) protocol client + DeepSeek Harness plugin: agent-native SAP ABAP access with features beyond VS Code ADT.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && tsc -p packages/dsh-plugin-abap-adt",
    "test": "pnpm build && node --test --test-timeout=60000 packages/adt-protocol/test/xml.test.ts packages/adt-mock/test/integration.test.ts",
    "mock": "node packages/adt-mock/lib/cli.js",
    "typecheck": "tsc -b --pretty false && tsc -p packages/dsh-plugin-abap-adt --pretty false"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@abap-adt/mock": "workspace:*",
    "@abap-adt/protocol": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
